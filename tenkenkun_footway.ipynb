      "source": [
        "import os, sys, re, json, math, time, shutil, zipfile, subprocess, unicodedata\n",
        "\n",
        "\n",
        "def _ensure_packages():\n",
        "    need = []\n",
        "    restart = False  # 読み込み済みの古いshapelyを更新する場合だけ、再起動が必要\n",
        "    try:\n",
        "        import shapely\n",
        "        if int(shapely.__version__.split(\".\")[0]) < 2:\n",
        "            need.append(\"shapely>=2.0\")\n",
        "            restart = True\n",
        "    except ImportError:\n",
        "        need.append(\"shapely>=2.0\")\n",
        "    for mod, pkg in [(\"pyogrio\", \"pyogrio\"), (\"geopandas\", \"geopandas\"),\n",
        "                     (\"requests\", \"requests\"), (\"tqdm\", \"tqdm\"),\n",
        "                     (\"pyproj\", \"pyproj\"), (\"scipy\", \"scipy\")]:\n",
        "        try:\n",
        "            __import__(mod)\n",
        "        except ImportError:\n",
        "            need.append(pkg)\n",
        "    if need:\n",
        "        subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\"] + need)\n",
        "        if restart:\n",
        "            raise SystemExit(\"shapely を更新しました。メニューの「ランタイム」→「ランタイムを再起動」\"\n",
        "                             \"をしてから、もう一度このセルを実行してください。\")\n",
        "\n",
        "\n",
        "_ensure_packages()\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import requests\n",
        "import shapely\n",
        "from shapely.geometry import mapping\n",
        "import geopandas as gpd\n",
        "from pyogrio import read_dataframe, list_drivers\n",
        "from scipy.sparse import coo_matrix\n",
        "from scipy.sparse.csgraph import connected_components\n",
        "from tqdm import tqdm\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 設定\n",
        "# ============================================================\n",
        "TARGET_HIGHWAYS = [\"footway\", \"path\", \"cycleway\", \"steps\"]\n",
        "\n",
        "# crossing 判定の相手にする道路（service は私道・駐車場出入口が多く誤検出が多いので除外。\n",
        "# 含めたい場合は \"service\" を追加）\n",
        "ROAD_HIGHWAYS = [\"motorway\", \"motorway_link\", \"trunk\", \"trunk_link\",\n",
        "                 \"primary\", \"primary_link\", \"secondary\", \"secondary_link\",\n",
        "                 \"tertiary\", \"tertiary_link\", \"unclassified\", \"residential\",\n",
        "                 \"living_street\"]\n",
        "\n",
        "# 接続判定に使うその他のway\n",
        "OTHER_NETWORK_HIGHWAYS = [\"service\", \"pedestrian\", \"corridor\",\n",
        "                          \"track\", \"bridleway\", \"road\"]\n",
        "\n",
        "NETWORK_HIGHWAYS = sorted(set(TARGET_HIGHWAYS + ROAD_HIGHWAYS + OTHER_NETWORK_HIGHWAYS))\n",
        "\n",
        "NEAR_TOL = 3.0          # 未接続候補: 端点から別wayまでの探索距離(m)\n",
        "DUP_TOL = 0.5           # 歩道の重複候補: 近接とみなす距離(m)\n",
        "DUP_OVERLAP = 0.80      # 歩道の重複候補: 短い方のwayがこの割合以上重なれば重複\n",
        "BBOX_MARGIN = 0.01      # 周辺道路を読む余白(度)\n",
        "POLY_BUFFER = 0.01      # 都道府県ポリゴンの余白(度)。簡易ポリゴンの海岸線ずれ対策\n",
        "\n",
        "WORK_DIR = \"/content\"\n",
        "OUT_DIR = \"/content/footway_output\"\n",
        "\n",
        "TAG_KEYS = {\"footway\": \"footway\", \"surface\": \"surface\", \"bridge\": \"bridge\",\n",
        "            \"tunnel\": \"tunnel\", \"layer\": \"layer_tag\", \"foot\": \"foot\",\n",
        "            \"bicycle\": \"bicycle\", \"access\": \"access\", \"crossing\": \"crossing\",\n",
        "            \"width\": \"width\", \"lit\": \"lit\", \"cycleway\": \"cycleway_tag\", \"horse\": \"horse\"}\n",
        "TAG_RE = re.compile(r'\"([^\"]+)\"=>\"((?:[^\"\\\\]|\\\\.)*)\"')\n",
        "\n",
        "# ============================================================\n",
        "# 都道府県 (名前, Geofabrik地域, フォールバック用bbox)\n",
        "# ============================================================\n",
        "PREFS = [\n",
        "    (\"北海道\", \"hokkaido\", (139.33, 41.35, 145.82, 45.56)),\n",
        "    (\"青森県\", \"tohoku\", (139.47, 40.20, 141.68, 41.56)),\n",
        "    (\"岩手県\", \"tohoku\", (140.65, 38.72, 142.07, 40.45)),\n",
        "    (\"宮城県\", \"tohoku\", (140.26, 37.77, 141.68, 39.00)),\n",
        "    (\"秋田県\", \"tohoku\", (139.68, 38.87, 140.99, 40.51)),\n",
        "    (\"山形県\", \"tohoku\", (139.47, 37.49, 140.65, 39.21)),\n",
        "    (\"福島県\", \"tohoku\", (139.17, 36.79, 141.05, 37.98)),\n",
        "    (\"茨城県\", \"kanto\", (139.64, 35.68, 140.85, 36.95)),\n",
        "    (\"栃木県\", \"kanto\", (139.34, 36.18, 140.29, 37.16)),\n",
        "    (\"群馬県\", \"kanto\", (138.38, 35.98, 139.68, 37.05)),\n",
        "    (\"埼玉県\", \"kanto\", (138.70, 35.75, 139.90, 36.29)),\n",
        "    (\"千葉県\", \"kanto\", (139.74, 34.89, 140.88, 36.10)),\n",
        "    (\"東京都\", \"kanto\", (138.94, 35.50, 139.92, 35.90)),\n",
        "    (\"神奈川県\", \"kanto\", (138.90, 35.12, 139.83, 35.67)),\n",
        "    (\"新潟県\", \"chubu\", (137.64, 36.73, 139.56, 38.55)),\n",
        "    (\"富山県\", \"chubu\", (136.77, 36.26, 137.77, 37.00)),\n",
        "    (\"石川県\", \"chubu\", (136.22, 36.06, 137.37, 37.00)),\n",
        "    (\"福井県\", \"chubu\", (135.44, 35.43, 136.84, 36.30)),\n",
        "    (\"山梨県\", \"chubu\", (138.17, 35.17, 139.18, 35.96)),\n",
        "    (\"長野県\", \"chubu\", (137.32, 35.18, 138.73, 37.01)),\n",
        "    (\"岐阜県\", \"chubu\", (136.28, 35.14, 137.66, 36.47)),\n",
        "    (\"静岡県\", \"chubu\", (137.47, 34.57, 139.18, 35.65)),\n",
        "    (\"愛知県\", \"chubu\", (136.67, 34.58, 137.83, 35.42)),\n",
        "    (\"三重県\", \"kansai\", (135.85, 33.72, 136.98, 35.25)),\n",
        "    (\"滋賀県\", \"kansai\", (135.73, 34.78, 136.45, 35.71)),\n",
        "    (\"京都府\", \"kansai\", (134.85, 34.70, 136.07, 35.79)),\n",
        "    (\"大阪府\", \"kansai\", (135.09, 34.26, 135.59, 34.83)),\n",
        "    (\"兵庫県\", \"kansai\", (134.24, 34.15, 135.47, 35.68)),\n",
        "    (\"奈良県\", \"kansai\", (135.57, 33.83, 136.04, 34.78)),\n",
        "    (\"和歌山県\", \"kansai\", (134.99, 33.43, 136.06, 34.38)),\n",
        "    (\"鳥取県\", \"chugoku\", (133.18, 35.03, 134.53, 35.60)),\n",
        "    (\"島根県\", \"chugoku\", (131.66, 34.28, 133.42, 36.34)),\n",
        "    (\"岡山県\", \"chugoku\", (133.19, 34.38, 134.43, 35.37)),\n",
        "    (\"広島県\", \"chugoku\", (132.02, 34.00, 133.50, 35.11)),\n",
        "    (\"山口県\", \"chugoku\", (130.77, 33.74, 132.25, 34.80)),\n",
        "    (\"徳島県\", \"shikoku\", (133.66, 33.53, 134.82, 34.36)),\n",
        "    (\"香川県\", \"shikoku\", (133.45, 34.00, 134.42, 34.50)),\n",
        "    (\"愛媛県\", \"shikoku\", (132.01, 32.88, 133.65, 34.30)),\n",
        "    (\"高知県\", \"shikoku\", (132.47, 32.71, 133.99, 33.88)),\n",
        "    (\"福岡県\", \"kyushu\", (129.99, 33.00, 131.00, 34.25)),\n",
        "    (\"佐賀県\", \"kyushu\", (129.70, 32.95, 130.55, 33.63)),\n",
        "    (\"長崎県\", \"kyushu\", (128.55, 32.55, 130.38, 34.71)),\n",
        "    (\"熊本県\", \"kyushu\", (129.72, 32.03, 131.33, 33.23)),\n",
        "    (\"大分県\", \"kyushu\", (130.82, 32.71, 131.98, 33.74)),\n",
        "    (\"宮崎県\", \"kyushu\", (130.72, 31.36, 131.89, 32.84)),\n",
        "    (\"鹿児島県\", \"kyushu\", (128.39, 27.00, 131.30, 32.31)),\n",
        "    (\"沖縄県\", \"kyushu\", (122.93, 24.00, 131.33, 27.88)),\n",
        "]\n",
        "\n",
        "REGION_URLS = {r: f\"https://download.geofabrik.de/asia/japan/{r}-latest.osm.pbf\"\n",
        "               for r in [\"hokkaido\", \"tohoku\", \"kanto\", \"chubu\",\n",
        "                         \"kansai\", \"chugoku\", \"shikoku\", \"kyushu\"]}\n",
        "PREF_POLY_URL = \"https://raw.githubusercontent.com/dataofjapan/land/master/japan.geojson\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# メニュー\n",
        "# ============================================================\n",
        "def _vwidth(s):\n",
        "    return sum(2 if unicodedata.east_asian_width(c) in \"WF\" else 1 for c in s)\n",
        "\n",
        "\n",
        "def show_menu(columns=5):\n",
        "    items = [f\"{i + 1:>2}: {p[0]}\" for i, p in enumerate(PREFS)]\n",
        "    print(\"表示したい都道府県の番号を入力してください\\n\")\n",
        "    for r in range(0, len(items), columns):\n",
        "        print(\"\".join(s + \" \" * (16 - _vwidth(s)) for s in items[r:r + columns]))\n",
        "    print()\n",
        "\n",
        "\n",
        "def ask_choice():\n",
        "    \"\"\"半角数字1つ(1〜47)だけ受け付ける。複数指定・範囲外・その他の入力は実行せず再入力。\"\"\"\n",
        "    while True:\n",
        "        text = input(\"番号 (1-47): \").strip()\n",
        "        if re.fullmatch(r\"[0-9]{1,2}\", text) and 1 <= int(text) <= 47:\n",
        "            return int(text)\n",
        "        print(\"1〜47の半角数字を1つだけ入力してください（複数選択・範囲外は実行しません）。\")\n",
        "\n",
        "\n",
        "def ask_yes_no(msg):\n",
        "    while True:\n",
        "        a = input(msg + \" [y/n]: \").strip().lower()\n",
        "        if a in (\"y\", \"yes\", \"はい\"):\n",
        "            return True\n",
        "        if a in (\"n\", \"no\", \"いいえ\"):\n",
        "            return False\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ダウンロード\n",
        "# ============================================================\n",
        "PBF_MAX_AGE_HOURS = 24  # これより古いPBFは再ダウンロード（latestは日々更新されるため）\n",
        "\n",
        "\n",
        "def download(url, path):\n",
        "    if os.path.exists(path) and os.path.getsize(path) > 0:\n",
        "        age_h = (time.time() - os.path.getmtime(path)) / 3600\n",
        "        if age_h < PBF_MAX_AGE_HOURS:\n",
        "            print(f\"既にあります（{age_h:.1f}時間前に取得）: {path}\")\n",
        "            return\n",
        "        print(f\"{age_h:.0f}時間前のファイルなので再取得します: {path}\")\n",
        "    tmp = path + \".part\"\n",
        "    last = None\n",
        "    for attempt in range(1, 4):\n",
        "        try:\n",
        "            print(f\"ダウンロード: {url}\")\n",
        "            with requests.get(url, stream=True, timeout=60,\n",
        "                              headers={\"User-Agent\": \"osm-footway-colab/1.0\"}) as r:\n",
        "                r.raise_for_status()\n",
        "                total = int(r.headers.get(\"content-length\", 0))\n",
        "                with open(tmp, \"wb\") as f, tqdm(total=total, unit=\"B\", unit_scale=True,\n",
        "                                                unit_divisor=1024) as bar:\n",
        "                    for chunk in r.iter_content(1 << 20):\n",
        "                        if chunk:\n",
        "                            f.write(chunk)\n",
        "                            bar.update(len(chunk))\n",
        "            os.replace(tmp, path)\n",
        "            return\n",
        "        except Exception as e:  # noqa\n",
        "            last = e\n",
        "            print(f\"  失敗({attempt}/3): {e}\")\n",
        "            time.sleep(5)\n",
        "    raise RuntimeError(f\"ダウンロードできませんでした: {url} ({last})\")\n",
        "\n",
        "\n",
        "def load_pref_polygon(name):\n",
        "    \"\"\"都道府県ポリゴン(簡易)を取得。失敗したら None。\"\"\"\n",
        "    try:\n",
        "        path = os.path.join(WORK_DIR, \"japan_pref.geojson\")\n",
        "        if not os.path.exists(path):\n",
        "            r = requests.get(PREF_POLY_URL, timeout=60)\n",
        "            r.raise_for_status()\n",
        "            with open(path, \"wb\") as f:\n",
        "                f.write(r.content)\n",
        "        g = gpd.read_file(path)\n",
        "        col = \"nam_ja\" if \"nam_ja\" in g.columns else None\n",
        "        if col is None:\n",
        "            return None\n",
        "        hit = g[g[col] == name]\n",
        "        if hit.empty:\n",
        "            return None\n",
        "        return shapely.union_all(hit.geometry.to_numpy())\n",
        "    except Exception as e:  # noqa\n",
        "        print(f\"  都道府県ポリゴンを取得できませんでした（bboxで代用）: {e}\")\n",
        "        return None\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 選択された都道府県の範囲でPBFを先にカット（osmium extract）\n",
        "# ============================================================\n",
        "def _ensure_osmium():\n",
        "    if shutil.which(\"osmium\"):\n",
        "        return True\n",
        "    try:\n",
        "        print(\"osmium-tool をインストール中...\")\n",
        "        subprocess.run([\"apt-get\", \"update\", \"-qq\"], check=True,\n",
        "                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
        "        subprocess.run([\"apt-get\", \"install\", \"-y\", \"-qq\", \"--no-install-recommends\", \"osmium-tool\"], check=True,\n",
        "                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
        "        return shutil.which(\"osmium\") is not None\n",
        "    except Exception as e:  # noqa\n",
        "        print(f\"  osmium-tool を入れられませんでした: {e}\")\n",
        "        return False\n",
        "\n",
        "\n",
        "def cut_pbf(src, scope, out):\n",
        "    \"\"\"scope(WGS84のポリゴン)の範囲だけを切り出したPBFのパスを返す。\n",
        "    失敗したら元のPBFのパスを返す（その場合は従来どおり地方全体から読む）。\"\"\"\n",
        "    try:\n",
        "        if os.path.exists(out) and os.path.getsize(out) > 0 \\\n",
        "                and os.path.getmtime(out) >= os.path.getmtime(src):\n",
        "            print(f\"切り出し済みのPBFを使います: {out}\")\n",
        "            return out\n",
        "        if not _ensure_osmium():\n",
        "            print(\"  切り出しをせず、地方全体のPBFを使います。\")\n",
        "            return src\n",
        "        geojson = out + \".geojson\"\n",
        "        with open(geojson, \"w\", encoding=\"utf-8\") as f:\n",
        "            json.dump({\"type\": \"Feature\", \"properties\": {},\n",
        "                       \"geometry\": mapping(scope)}, f)\n",
        "        print(\"選択された都道府県の範囲でPBFファイルをカット中...\")\n",
        "        t0 = time.time()\n",
        "        subprocess.run([\"osmium\", \"extract\", \"-p\", geojson, \"--overwrite\",\n",
        "                        \"-o\", out, src], check=True,\n",
        "                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n",
        "        print(f\"  カット完了: {os.path.getsize(src) / 1e6:,.0f}MB → \"\n",
        "              f\"{os.path.getsize(out) / 1e6:,.0f}MB（{time.time() - t0:.0f}秒）\")\n",
        "        return out\n",
        "    except Exception as e:  # noqa\n",
        "        detail = getattr(e, \"stderr\", b\"\")\n",
        "        if isinstance(detail, bytes):\n",
        "            detail = detail.decode(\"utf-8\", \"ignore\")[-300:]\n",
        "        print(f\"  カットに失敗したため、地方全体のPBFを使います: {e} {detail}\")\n",
        "        return src\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 読み込み・タグ展開\n",
        "# ============================================================\n",
        "def parse_tags(series):\n",
        "    cols = {v: [] for v in TAG_KEYS.values()}\n",
        "    for s in series.to_numpy():\n",
        "        d = dict(TAG_RE.findall(s)) if isinstance(s, str) else {}\n",
        "        for k, out in TAG_KEYS.items():\n",
        "            cols[out].append(d.get(k))\n",
        "    return pd.DataFrame(cols)\n",
        "\n",
        "\n",
        "def read_ways(pbf, bbox, highways):\n",
        "    if \"OSM\" not in list_drivers():\n",
        "        raise RuntimeError(\"この環境の GDAL に OSM ドライバがありません。\"\n",
        "                           \"`!apt-get -y install gdal-bin python3-gdal` 等で GDAL を入れてください。\")\n",
        "    where = \"highway IN (%s)\" % \",\".join(f\"'{h}'\" for h in highways)\n",
        "    print(\"PBFを読み込み中（数分かかることがあります）...\")\n",
        "    gdf = read_dataframe(pbf, layer=\"lines\", bbox=bbox, where=where,\n",
        "                         columns=[\"osm_id\", \"name\", \"highway\", \"other_tags\"])\n",
        "    print(f\"  読み込み: {len(gdf):,} way\")\n",
        "    return gdf\n",
        "\n",
        "\n",
        "def read_crossing_nodes(pbf, bbox, metric_crs):\n",
        "    \"\"\"(横断歩道ノードの座標キー, そのうち crossing=* が付いているものの座標キー) を返す。\n",
        "    失敗したら None。\"\"\"\n",
        "    try:\n",
        "        print(\"横断歩道ノード(highway=crossing)を読み込み中...\")\n",
        "        pts = read_dataframe(pbf, layer=\"points\", bbox=bbox,\n",
        "                             where=\"highway IN ('crossing','traffic_signals')\",\n",
        "                             columns=[\"osm_id\", \"highway\", \"other_tags\"])\n",
        "        tags = pts[\"other_tags\"].fillna(\"\")\n",
        "        pts = pts[(pts[\"highway\"] == \"crossing\") | tags.str.contains('\"crossing\"=>')]\n",
        "        tags = pts[\"other_tags\"].fillna(\"\")\n",
        "        typed = tags.str.contains(r'\"crossing\"=>\"[^\"]+\"', regex=True).to_numpy()\n",
        "        print(f\"  横断歩道ノード: {len(pts):,} 件（うち crossing=* あり {int(typed.sum()):,} 件）\")\n",
        "        if pts.empty:\n",
        "            empty = np.array([], dtype=np.int64)\n",
        "            return empty, empty\n",
        "        xy = shapely.get_coordinates(pts.to_crs(metric_crs).geometry.to_numpy())\n",
        "        keys = _coord_keys(xy)\n",
        "        return keys, keys[typed]\n",
        "    except Exception as e:  # noqa\n",
        "        print(f\"  横断歩道ノードを読み込めませんでした（横断歩道ノード・種類の判定は省略）: {e}\")\n",
        "        return None\n",
        "\n",
        "\n",
        "def prepare_network(gdf, metric_crs, scope_geom):\n",
        "    \"\"\"タグ展開・スコープ判定・メートル系への変換。\"\"\"\n",
        "    gdf = gdf[gdf.geometry.notna() & ~gdf.geometry.is_empty].copy()\n",
        "    gdf = gdf.explode(index_parts=False)\n",
        "    gdf = gdf[gdf.geom_type == \"LineString\"].reset_index(drop=True)\n",
        "    tags = parse_tags(gdf[\"other_tags\"])\n",
        "    gdf = gdf.drop(columns=[\"other_tags\"])\n",
        "    for c in tags.columns:\n",
        "        gdf[c] = tags[c].values\n",
        "    gdf[\"is_target\"] = gdf[\"highway\"].isin(TARGET_HIGHWAYS).to_numpy()\n",
        "    if scope_geom is None:\n",
        "        inside = np.ones(len(gdf), dtype=bool)\n",
        "    else:\n",
        "        shapely.prepare(scope_geom)\n",
        "        inside = shapely.intersects(gdf.geometry.to_numpy(), scope_geom)\n",
        "    gdf[\"in_scope\"] = gdf[\"is_target\"].to_numpy() & inside\n",
        "    return gdf, gdf.to_crs(metric_crs)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 幾何ユーティリティ\n",
        "# ============================================================\n",
        "# 座標をcm単位の整数にして、XとYを1つのキーにまとめる（ノード共有の判定用）。\n",
        "# UTMのY(北距)は日本では最大でも約5.0e8cmなので、X側に2e9を掛ければ衝突しない。\n",
        "# 共有ノードは同じ座標値から同じ投影結果になるため、丸めの境界で別キーになることはない。\n",
        "KEY_SCALE = 2_000_000_000\n",
        "\n",
        "\n",
        "def _coord_keys(xy):\n",
        "    ix = np.round(xy[:, 0] * 100).astype(np.int64)\n",
        "    iy = np.round(xy[:, 1] * 100).astype(np.int64)\n",
        "    return ix * KEY_SCALE + iy\n",
        "\n",
        "\n",
        "def node_keys(geoms):\n",
        "    coords, idx = shapely.get_coordinates(geoms, return_index=True)\n",
        "    return _coord_keys(coords), idx\n",
        "\n",
        "\n",
        "def query_dwithin(tree, geoms, dist):\n",
        "    \"\"\"geoms から dist 以内の tree 内ジオメトリのペア (2, n) を返す。\"\"\"\n",
        "    try:\n",
        "        return tree.query(geoms, predicate=\"dwithin\", distance=dist)\n",
        "    except Exception:  # GEOSが古い場合\n",
        "        return tree.query(shapely.buffer(geoms, dist), predicate=\"intersects\")\n",
        "\n",
        "\n",
        "def _elevated(net):\n",
        "    def flag(s):\n",
        "        return (s.notna() & (s != \"no\")).to_numpy()\n",
        "    return flag(net[\"bridge\"]) | flag(net[\"tunnel\"])\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 品質チェック本体（net はメートル系CRSのGeoDataFrame）\n",
        "# ============================================================\n",
        "def run_qc(net, crossing_nodes=None):\n",
        "    crs = net.crs\n",
        "    geoms = net.geometry.to_numpy()\n",
        "    n = len(net)\n",
        "    osm = net[\"osm_id\"].to_numpy()\n",
        "    hw = net[\"highway\"].to_numpy()\n",
        "    in_scope = net[\"in_scope\"].to_numpy()\n",
        "    lengths = shapely.length(geoms)\n",
        "    results = {}\n",
        "\n",
        "    # --- ノード共有の集計 ---\n",
        "    key, widx = node_keys(geoms)\n",
        "    pairs = pd.DataFrame({\"key\": key, \"way\": widx}).drop_duplicates()\n",
        "    cnt = pairs[\"key\"].value_counts()\n",
        "    shared_keys = cnt.index[cnt.to_numpy() > 1].to_numpy()\n",
        "\n",
        "    # --- 1. 未接続候補 ---\n",
        "    print(\"  1/5 未接続候補...\")\n",
        "    closed = shapely.equals(shapely.get_point(geoms, 0), shapely.get_point(geoms, -1))\n",
        "    cand = np.where(in_scope & ~closed)[0]\n",
        "    tree_all = shapely.STRtree(geoms)\n",
        "    rows = []\n",
        "    for side, pos in ((\"start\", 0), (\"end\", -1)):\n",
        "        pts = shapely.get_point(geoms[cand], pos)\n",
        "        xy = shapely.get_coordinates(pts)\n",
        "        c = cnt.reindex(_coord_keys(xy)).fillna(0).to_numpy()\n",
        "        free = c <= 1\n",
        "        if not free.any():\n",
        "            continue\n",
        "        pts_f, own_f = pts[free], cand[free]\n",
        "        q = query_dwithin(tree_all, pts_f, NEAR_TOL)\n",
        "        keep = q[1] != own_f[q[0]]\n",
        "        qi, qj = q[0][keep], q[1][keep]\n",
        "        if len(qi) == 0:\n",
        "            continue\n",
        "        dist = shapely.distance(pts_f[qi], geoms[qj])\n",
        "        df = pd.DataFrame({\"p\": qi, \"j\": qj, \"d\": dist})\n",
        "        best = df.loc[df.groupby(\"p\")[\"d\"].idxmin()]\n",
        "        for p, j, d in zip(best[\"p\"], best[\"j\"], best[\"d\"]):\n",
        "            o = own_f[p]\n",
        "            pt = pts_f[p]\n",
        "            rows.append({\"osm_id\": osm[o], \"highway\": hw[o], \"end\": side,\n",
        "                         \"nearest_osm_id\": osm[j], \"nearest_highway\": hw[j],\n",
        "                         \"distance_m\": round(float(d), 2),\n",
        "                         \"geometry\": pt})\n",
        "    results[\"1_unconnected\"] = (gpd.GeoDataFrame(rows, geometry=\"geometry\", crs=crs)\n",
        "                                if rows else None)\n",
        "\n",
        "    # --- 2. 孤立ネットワーク ---\n",
        "    print(\"  2/5 孤立ネットワーク...\")\n",
        "    p = pairs.sort_values([\"key\", \"way\"])\n",
        "    k, w = p[\"key\"].to_numpy(), p[\"way\"].to_numpy()\n",
        "    m = k[:-1] == k[1:]\n",
        "    g = coo_matrix((np.ones(m.sum()), (w[:-1][m], w[1:][m])), shape=(n, n))\n",
        "    _, labels = connected_components(g, directed=False)\n",
        "    comp = pd.DataFrame({\"comp\": labels, \"len\": lengths,\n",
        "                         \"nontarget\": (~net[\"is_target\"].to_numpy()).astype(int)})\n",
        "    agg = comp.groupby(\"comp\").agg(ways=(\"len\", \"size\"), length=(\"len\", \"sum\"),\n",
        "                                   nontarget=(\"nontarget\", \"sum\"))\n",
        "    isolated_comps = agg.index[agg[\"nontarget\"] == 0]\n",
        "    sel = in_scope & np.isin(labels, isolated_comps.to_numpy())\n",
        "    if sel.any():\n",
        "        iso = net.loc[sel, [\"osm_id\", \"highway\", \"name\", \"geometry\"]].copy()\n",
        "        iso[\"network_id\"] = labels[sel]\n",
        "        iso[\"network_ways\"] = agg.loc[labels[sel], \"ways\"].to_numpy()\n",
        "        iso[\"network_length_m\"] = agg.loc[labels[sel], \"length\"].round(1).to_numpy()\n",
        "        results[\"2_isolated\"] = iso\n",
        "    else:\n",
        "        results[\"2_isolated\"] = None\n",
        "\n",
        "    # --- 3. 歩道の重複候補 ---\n",
        "    print(\"  3/5 歩道の重複候補...\")\n",
        "    sub = np.where(in_scope)[0]\n",
        "    dup = None\n",
        "    if len(sub) > 1:\n",
        "        gs = geoms[sub]\n",
        "        ls = lengths[sub]\n",
        "        tree_s = shapely.STRtree(gs)\n",
        "        q = query_dwithin(tree_s, gs, DUP_TOL)\n",
        "        q = q[:, q[0] < q[1]]\n",
        "        if q.shape[1]:\n",
        "            a = np.where(ls[q[0]] <= ls[q[1]], q[0], q[1])\n",
        "            b = np.where(ls[q[0]] <= ls[q[1]], q[1], q[0])\n",
        "            ok = (ls[a] > 0) & (hw[sub[a]] == hw[sub[b]])  # 同じhighway同士のみ\n",
        "            a, b = a[ok], b[ok]\n",
        "            ov = shapely.length(shapely.intersection(gs[a], shapely.buffer(gs[b], DUP_TOL)))\n",
        "            ratio = ov / ls[a]\n",
        "            hit = ratio >= DUP_OVERLAP\n",
        "            if hit.any():\n",
        "                ia, ib = sub[a[hit]], sub[b[hit]]\n",
        "                dup = gpd.GeoDataFrame({\n",
        "                    \"osm_id\": osm[ia], \"highway\": hw[ia],\n",
        "                    \"other_osm_id\": osm[ib], \"other_highway\": hw[ib],\n",
        "                    \"overlap_ratio\": np.round(ratio[hit], 2)},\n",
        "                    geometry=geoms[ia], crs=crs)\n",
        "    results[\"3_duplicate\"] = dup\n",
        "\n",
        "    # --- 4. 横断歩道タグ不足候補 ---\n",
        "    print(\"  4/5 横断歩道タグ不足候補...\")\n",
        "    road_idx = np.where(np.isin(hw, ROAD_HIGHWAYS))[0]\n",
        "    way_typed = net[\"crossing\"].notna().to_numpy()\n",
        "    way_is_xing = ((net[\"footway\"] == \"crossing\")\n",
        "                   | (net[\"cycleway_tag\"] == \"crossing\")\n",
        "                   | net[\"crossing\"].notna()).to_numpy()\n",
        "    xing_ways = sub[way_is_xing[sub]]\n",
        "    if crossing_nodes is not None:\n",
        "        node_all, node_typed = crossing_nodes\n",
        "    else:\n",
        "        node_all = node_typed = None\n",
        "    handled = np.zeros(n, dtype=bool)  # 道路との交点が見つかった横断歩道\n",
        "    frames = []\n",
        "    if len(road_idx) and len(sub):\n",
        "        tree_r = shapely.STRtree(geoms[road_idx])\n",
        "        # 交差: すべての歩道が対象 / 接触(端点どうしなど): 横断歩道だけが対象\n",
        "        q1 = tree_r.query(geoms[sub], predicate=\"crosses\")\n",
        "        t_parts = [sub[q1[0]]]\n",
        "        r_parts = [road_idx[q1[1]]]\n",
        "        if len(xing_ways):\n",
        "            q2 = tree_r.query(geoms[xing_ways], predicate=\"intersects\")\n",
        "            t_parts.append(xing_ways[q2[0]])\n",
        "            r_parts.append(road_idx[q2[1]])\n",
        "        t = np.concatenate(t_parts)\n",
        "        r = np.concatenate(r_parts)\n",
        "        if len(t):\n",
        "            pr = pd.DataFrame({\"t\": t, \"r\": r}).drop_duplicates()\n",
        "            t, r = pr[\"t\"].to_numpy(), pr[\"r\"].to_numpy()\n",
        "            elev = _elevated(net)\n",
        "            lay = pd.to_numeric(net[\"layer_tag\"], errors=\"coerce\").fillna(0).to_numpy()\n",
        "            ok = ~elev[t] & ~elev[r] & (lay[t] == lay[r])\n",
        "            t, r = t[ok], r[ok]\n",
        "        if len(t):\n",
        "            inter = shapely.intersection(geoms[t], geoms[r])\n",
        "            parts, pi = shapely.get_parts(inter, return_index=True)\n",
        "            is_pt = shapely.get_type_id(parts) == 0\n",
        "            parts, pi = parts[is_pt], pi[is_pt]\n",
        "            if len(parts):\n",
        "                pkeys = _coord_keys(shapely.get_coordinates(parts))\n",
        "                tt, rr = t[pi], r[pi]\n",
        "                # 道路が交点で分割されている場合など、同じ交点は1件にまとめる\n",
        "                first = ~pd.DataFrame({\"t\": tt, \"k\": pkeys}).duplicated().to_numpy()\n",
        "                parts, pkeys, tt, rr = parts[first], pkeys[first], tt[first], rr[first]\n",
        "                handled[tt[way_is_xing[tt]]] = True\n",
        "                shared = np.isin(pkeys, shared_keys)\n",
        "                if node_all is not None:\n",
        "                    has_node = np.isin(pkeys, node_all)\n",
        "                    has_type = np.isin(pkeys, node_typed)\n",
        "                else:  # 横断ノードを読めなかった場合は、ノードと種類の判定を省略\n",
        "                    has_node = has_type = np.ones(len(parts), dtype=bool)\n",
        "                issue = np.where(~shared, \"ノード未共有\",\n",
        "                                 np.where(~has_node, \"横断歩道ノードなし\",\n",
        "                                          np.where(~has_type, \"横断歩道ノードの種類なし\", \"\")))\n",
        "                keep = issue != \"\"\n",
        "                if keep.any():\n",
        "                    tk, rk = tt[keep], rr[keep]\n",
        "                    contact = np.where(shapely.crosses(geoms[tk], geoms[rk]),\n",
        "                                       \"交差\", \"端点接触\")\n",
        "                    frames.append(gpd.GeoDataFrame({\n",
        "                        \"issue\": issue[keep], \"contact\": contact,\n",
        "                        \"osm_id\": osm[tk], \"highway\": hw[tk],\n",
        "                        \"footway\": net[\"footway\"].to_numpy()[tk],\n",
        "                        \"crossing\": net[\"crossing\"].to_numpy()[tk],\n",
        "                        \"way_is_crossing\": way_is_xing[tk],\n",
        "                        \"road_osm_id\": osm[rk], \"road_highway\": hw[rk]},\n",
        "                        geometry=parts[keep], crs=crs))\n",
        "    # 道路との交点がない横断歩道way（way にもノードにも crossing=* がないもの）\n",
        "    if node_typed is not None and len(xing_ways):\n",
        "        cand = xing_ways[~handled[xing_ways]]\n",
        "        if len(cand):\n",
        "            keys, widx = node_keys(geoms[cand])\n",
        "            node_has = np.zeros(len(cand), dtype=bool)\n",
        "            node_has[widx[np.isin(keys, node_typed)]] = True\n",
        "            miss = ~(node_has | way_typed[cand])\n",
        "            if miss.any():\n",
        "                cm = cand[miss]\n",
        "                mid = shapely.line_interpolate_point(geoms[cm], 0.5, normalized=True)\n",
        "                frames.append(gpd.GeoDataFrame({\n",
        "                    \"issue\": \"横断歩道の種類なし\", \"contact\": \"交点なし\",\n",
        "                    \"osm_id\": osm[cm], \"highway\": hw[cm],\n",
        "                    \"footway\": net[\"footway\"].to_numpy()[cm],\n",
        "                    \"crossing\": net[\"crossing\"].to_numpy()[cm],\n",
        "                    \"way_is_crossing\": True,\n",
        "                    \"road_osm_id\": \"\", \"road_highway\": \"\"},\n",
        "                    geometry=mid, crs=crs))\n",
        "    results[\"4_crossing\"] = (gpd.GeoDataFrame(pd.concat(frames, ignore_index=True),\n",
        "                                              geometry=\"geometry\", crs=crs)\n",
        "                             if frames else None)\n",
        "\n",
        "    # --- 5. 表面のタグ付け不足候補 ---\n",
        "    print(\"  5/5 表面のタグ付け不足候補...\")\n",
        "    tg = net[in_scope]\n",
        "    no_surface = tg[\"surface\"].isna().to_numpy()\n",
        "    attr = None\n",
        "    if no_surface.any():\n",
        "        attr = tg.loc[no_surface, [\"osm_id\", \"highway\", \"name\", \"footway\", \"surface\",\n",
        "                                   \"geometry\"]].copy()\n",
        "        attr[\"missing_tags\"] = \"surface\"\n",
        "    results[\"5_attribute\"] = attr\n",
        "\n",
        "    return results\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 保存\n",
        "# ============================================================\n",
        "BASE_COLS = [\"osm_id\", \"name\", \"highway\", \"footway\", \"surface\", \"bridge\", \"tunnel\",\n",
        "             \"layer_tag\", \"foot\", \"bicycle\", \"horse\", \"access\", \"crossing\", \"width\", \"lit\",\n",
        "             \"cycleway_tag\"]\n",
        "\n",
        "\n",
        "def save_gpkg(gdf, path, layer):\n",
        "    if os.path.exists(path):\n",
        "        os.remove(path)\n",
        "    gdf.to_file(path, layer=layer, driver=\"GPKG\", engine=\"pyogrio\")\n",
        "\n",
        "\n",
        "def utm_crs_for(lon):\n",
        "    return f\"EPSG:{32600 + int(math.floor((lon + 180) / 6) + 1)}\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# メイン\n",
        "# ============================================================\n",
        "def main():\n",
        "    show_menu()\n",
        "    choice = ask_choice()\n",
        "    do_qc = ask_yes_no(\"歩道の品質チェックを実施しますか？\")\n",
        "\n",
        "    name, region, fb_bbox = PREFS[choice - 1]\n",
        "    label = f\"{choice:02d}_{name}\"\n",
        "    pbf = os.path.join(WORK_DIR, os.path.basename(REGION_URLS[region]))\n",
        "    download(REGION_URLS[region], pbf)\n",
        "    poly = load_pref_polygon(name)\n",
        "    if poly is None:\n",
        "        if do_qc:\n",
        "            raise SystemExit(\"都道府県の境界を取得できなかったため中止します。\"\n",
        "                             \"bboxで代用すると隣県のwayが混ざり、品質チェックの結果が不正確になります。\"\n",
        "                             \"ネットワーク接続を確認して再実行してください。\")\n",
        "        print(\"警告: 都道府県の境界を取得できなかったため bbox で代用します。\"\n",
        "              \"隣県のwayが混ざる可能性があります。\")\n",
        "        scope = shapely.box(*fb_bbox)\n",
        "    else:\n",
        "        scope = shapely.buffer(poly, POLY_BUFFER)\n",
        "    minx, miny, maxx, maxy = scope.bounds\n",
        "    bbox = (minx - BBOX_MARGIN, miny - BBOX_MARGIN, maxx + BBOX_MARGIN, maxy + BBOX_MARGIN)\n",
        "    metric_crs = utm_crs_for(scope.centroid.x)\n",
        "\n",
        "    print(f\"\\n対象: {label}  距離計算CRS: {metric_crs}\")\n",
        "\n",
        "    pbf = cut_pbf(pbf, scope, os.path.join(WORK_DIR, f\"cut_{choice:02d}.osm.pbf\"))\n",
        "\n",
        "    if os.path.exists(OUT_DIR):\n",
        "        shutil.rmtree(OUT_DIR)\n",
        "    os.makedirs(OUT_DIR)\n",
        "\n",
        "    raw = read_ways(pbf, bbox, NETWORK_HIGHWAYS if do_qc else TARGET_HIGHWAYS)\n",
        "    crossing_keys = read_crossing_nodes(pbf, bbox, metric_crs) if do_qc else None\n",
        "    net4326, net = prepare_network(raw, metric_crs, scope)\n",
        "    del raw\n",
        "    n_target = int(net4326[\"in_scope\"].sum())\n",
        "    print(f\"歩道数: {n_target:,}\")\n",
        "    if n_target == 0:\n",
        "        raise SystemExit(\"対象のwayが見つかりませんでした。\")\n",
        "\n",
        "    # 基本 GPKG\n",
        "    base = net4326.loc[net4326[\"in_scope\"], BASE_COLS + [\"geometry\"]]\n",
        "    base_path = os.path.join(OUT_DIR, f\"{name}の歩道.gpkg\")\n",
        "    save_gpkg(base, base_path, f\"{name}_歩道\")\n",
        "    print(f\"作成: {os.path.basename(base_path)}\")\n",
        "\n",
        "    # 品質チェック\n",
        "    if do_qc:\n",
        "        print(\"\\n歩道の品質チェックを開始します...\")\n",
        "        results = run_qc(net, crossing_keys)\n",
        "        names = {\"1_unconnected\": \"未接続候補\", \"2_isolated\": \"孤立ネットワーク\",\n",
        "                 \"3_duplicate\": \"歩道の重複候補\", \"4_crossing\": \"横断歩道タグ不足候補\",\n",
        "                 \"5_attribute\": \"表面のタグ付け不足候補\"}\n",
        "        print(\"\\n品質チェックが完了しました。チェックした結果は次のようになります:\")\n",
        "        for k, v in results.items():\n",
        "            count = 0 if v is None else len(v)\n",
        "            print(f\"  {names[k]:<10}: {count:,} 件\")\n",
        "            if k == \"4_crossing\" and count:\n",
        "                for iss, cn in v[\"issue\"].value_counts().items():\n",
        "                    print(f\"      └ {iss}: {cn:,} 件\")\n",
        "            if v is not None and count:\n",
        "                # QGISのレイヤ名になる: 例「東京都_QC1_未接続候補」\n",
        "                qc_name = f\"QC{k[0]}_{names[k]}\"\n",
        "                path = os.path.join(OUT_DIR, f\"{name}_{qc_name}.gpkg\")\n",
        "                save_gpkg(v.to_crs(\"EPSG:4326\"), path, f\"{name}_{qc_name}\")\n",
        "\n",
        "    # GPKGの統合（個別のGPKGを1つにまとめ、元の個別ファイルは削除）\n",
        "    from pyogrio import list_layers\n",
        "\n",
        "    parts = sorted((f for f in os.listdir(OUT_DIR) if f.endswith(".gpkg")),\n",
        "                   key=lambda f: (not f.endswith("の歩道.gpkg"), f))  # 基本レイヤを先頭に\n",
        "    merged_tmp = os.path.join(WORK_DIR, f"{name}の歩道データ.gpkg")\n",
        "    if os.path.exists(merged_tmp):\n",
        "        os.remove(merged_tmp)\n",
        "\n",
        "    print("\nGPKGを統合中...")\n",
        "    for f in parts:\n",
        "        src = os.path.join(OUT_DIR, f)\n",
        "        for layer, _ in list_layers(src):\n",
        "            read_dataframe(src, layer=layer).to_file(\n",
        "                merged_tmp, layer=layer, driver="GPKG", engine="pyogrio", mode="a")\n",
        "            print(f"  レイヤ追加: {layer}")\n",
        "        os.remove(src)\n",
        "\n",
        "    shutil.move(merged_tmp, os.path.join(OUT_DIR, os.path.basename(merged_tmp)))\n",
        "\n",
        "    # ZIP\n",
        "    zip_path = os.path.join(WORK_DIR, f\"{name}の歩道データ.zip\")\n",
        "    with zipfile.ZipFile(zip_path, \"w\", zipfile.ZIP_DEFLATED) as z:\n",
        "        for f in sorted(os.listdir(OUT_DIR)):\n",
