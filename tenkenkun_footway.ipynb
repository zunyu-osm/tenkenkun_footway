        "    print(f\"\\nZIPファイルを作成: {zip_path}\")\n",
        "\n",
        "    try:\n",
        "        from google.colab import files\n",
        "        files.download(zip_path)\n",
        "    except ImportError:\n",
        "        print(\"Colab 以外の環境のため自動ダウンロードはスキップしました。\")\n",
